# Copy to worker/.env for local runs. Never commit the real file or put the API key in frontend code.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=paper2career_db
AUTO_PUBLISH=true

# Optional
# OCR_ENGINE=tesseract            # or rapidocr
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# LOOKBACK_DAYS=3
# REVIEW_CONFIDENCE_THRESHOLD=0.75
